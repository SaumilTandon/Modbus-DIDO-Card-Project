/* USER CODE BEGIN 4 */
void HAL_UART_IDLECallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == LPUART1) {
        uint16_t received = RX_BUFFER_SIZE - __HAL_DMA_GET_COUNTER(huart->hdmarx);

        // Null-terminate safely
        if (received < RX_BUFFER_SIZE) {
            rxBuffer[received] = '\0';
        } else {
            rxBuffer[RX_BUFFER_SIZE-1] = '\0';
        }

        // Trim trailing CR/LF and spaces
        for (int i = 0; i < received; i++) {
            if (rxBuffer[i] == '\r' || rxBuffer[i] == '\n' || rxBuffer[i] == ' ') {
                rxBuffer[i] = '\0';
                break;
            }
        }

        // Debug print to COM3
        printf("RX: '%s'\r\n", rxBuffer);

        // Compare using substring search
        if (strstr(rxBuffer, "Namaste") != NULL) {
            strcpy(txBuffer, "hello\r\n");
        }
        else if (strstr(rxBuffer, "Kaise Ho Aap") != NULL) {
            strcpy(txBuffer, "Mai Badhiya\r\n");
        }
        else {
            snprintf(txBuffer, sizeof(txBuffer), "Message received: %s\r\n", rxBuffer);
        }

        HAL_UART_Transmit_DMA(&hlpuart1, (uint8_t *)txBuffer, strlen(txBuffer));

        // Clear buffer before reuse
        memset(rxBuffer, 0, RX_BUFFER_SIZE);

        // Restart DMA reception
        HAL_UART_Receive_DMA(&hlpuart1, (uint8_t *)rxBuffer, RX_BUFFER_SIZE);
    }
}




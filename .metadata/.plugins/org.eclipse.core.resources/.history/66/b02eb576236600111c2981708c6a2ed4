#include "sx126x_hal.h"
#include "main.h"
#include <string.h>

extern SPI_HandleTypeDef hspi1;

//                                                                         //

static void SX1262_WaitOnBusy(void)
{
    while(HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_0) == GPIO_PIN_SET)
    {
    }
}

//                                                                         //

sx126x_hal_status_t sx126x_hal_write(
        const void* context,
        const uint8_t* command,
        const uint16_t command_length,
        const uint8_t* data,
        const uint16_t data_length )
{
    (void)context;

    SX1262_WaitOnBusy();

    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET);

    if(HAL_SPI_Transmit(&hspi1,
                        (uint8_t*)command,
                        command_length,
                        HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);
        return SX126X_HAL_STATUS_ERROR;
    }

    if(data_length > 0)
    {
        if(HAL_SPI_Transmit(&hspi1,
                            (uint8_t*)data,
                            data_length,
                            HAL_MAX_DELAY) != HAL_OK)
        {
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);
            return SX126X_HAL_STATUS_ERROR;
        }
    }

    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);

    SX1262_WaitOnBusy();

    return SX126X_HAL_STATUS_OK;
}

//                                                                           //

sx126x_hal_status_t sx126x_hal_read(
        const void* context,
        const uint8_t* command,
        const uint16_t command_length,
        uint8_t* data,
        const uint16_t data_length )
{
    (void)context;

    uint8_t nop[data_length];

    memset(nop, SX126X_NOP, data_length);

    SX1262_WaitOnBusy();

    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET);

    if(HAL_SPI_Transmit(&hspi1,
                        (uint8_t*)command,
                        command_length,
                        HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);
        return SX126X_HAL_STATUS_ERROR;
    }

    if(HAL_SPI_TransmitReceive(&hspi1,
                               nop,
                               data,
                               data_length,
                               HAL_MAX_DELAY) != HAL_OK)
    {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);
        return SX126X_HAL_STATUS_ERROR;
    }

    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);

    return SX126X_HAL_STATUS_OK;
}

//                                                                         //

sx126x_hal_status_t sx126x_hal_reset(const void* context)
{
    (void)context;

    HAL_GPIO_WritePin(GPIOC,
                      GPIO_PIN_1,
                      GPIO_PIN_RESET);

    HAL_Delay(20);

    HAL_GPIO_WritePin(GPIOC,
                      GPIO_PIN_1,
                      GPIO_PIN_SET);

    HAL_Delay(10);

    return SX126X_HAL_STATUS_OK;
}

//                                                                           //

sx126x_hal_status_t sx126x_hal_wakeup(const void* context)
{
    (void)context;

    uint8_t wakeup = SX126X_NOP;

    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_4,
                      GPIO_PIN_RESET);

    HAL_SPI_Transmit(&hspi1,
                     &wakeup,
                     1,
                     HAL_MAX_DELAY);

    HAL_GPIO_WritePin(GPIOA,
                      GPIO_PIN_4,
                      GPIO_PIN_SET);

    HAL_Delay(1);

    SX1262_WaitOnBusy();

    return SX126X_HAL_STATUS_OK;
}


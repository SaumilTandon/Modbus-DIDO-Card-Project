uint16_t My_ADC_Read(uint32_t channel)
{
	 HAL_ADC_Stop(&hadc);          // ensure clean state before reconfiguring
	    ADC1->CHSELR = 0;             // clear all channels - THE critical fix
	    ADC_ChannelConfTypeDef sConfig = {0};
	    sConfig.Channel      = channel;
	    sConfig.Rank         = ADC_RANK_CHANNEL_NUMBER;
	    sConfig.SamplingTime = ADC_SAMPLETIME_55CYCLES_5;
	    if (HAL_ADC_ConfigChannel(&hadc, &sConfig) != HAL_OK)
	        return 0xFFFF;            // distinct error sentinel
	    if (HAL_ADC_Start(&hadc) != HAL_OK)
	        return 0xFFFF;
	    if (HAL_ADC_PollForConversion(&hadc, 10) != HAL_OK)
	        return 0xFFFF;
	    uint16_t value = HAL_ADC_GetValue(&hadc);
	    HAL_ADC_Stop(&hadc);
	    return value;
}

void Coil_Write(uint8_t coilIndex, uint8_t value)
{
    if (coilIndex < NUM_COILS) {
        coilStatus[coilIndex] = value ? 1 : 0;
        HAL_GPIO_WritePin(coilPortMap[coilIndex], coilPinMap[coilIndex],
                          value ? GPIO_PIN_SET : GPIO_PIN_RESET);
    }
}

uint8_t Coil_Read(uint8_t coilIndex)
{
    if (coilIndex < NUM_COILS) {
        return coilStatus[coilIndex];  // Read shadow, not GPIO IDR
    }
    return 0;
}

// ── Digital inputs ───────────────────────────────────────────────────────────
// Active HIGH: signal applied → HIGH → returns 1
// Nothing connected → divider pulls LOW → returns 0

uint8_t DIn_Read(uint8_t dinIndex)
{
  if (dinIndex < NUM_DIN)
    return (HAL_GPIO_ReadPin(dinPortMap[dinIndex], dinPinMap[dinIndex]) == GPIO_PIN_SET) ? 1 : 0;
  return 0;
}

void Status_SendDebug(void)
{
    char buf[80];
    int len = snprintf(buf, sizeof(buf),
        "D1:%d D2:%d D3:%d D4:%d | A1:%4d A2:%4d A3:%4d A4:%4d\r\n",
        DIn_Read(0), DIn_Read(1), DIn_Read(2), DIn_Read(3),
        adcValue[0], adcValue[1], adcValue[2], adcValue[3]);

    txInProgress = 1;
    HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_SET);
    HAL_Delay(1);
    HAL_UART_Transmit(&huart1, (uint8_t*)buf, (uint16_t)len, 100);
    HAL_Delay(2);
    HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_RESET);
    HAL_Delay(1);
    txInProgress = 0;
}



uint16_t Modbus_CRC16(uint8_t *buf, uint16_t len)
{
    uint16_t crc = 0xFFFF;
    for (uint16_t pos = 0; pos < len; pos++) {
        crc ^= buf[pos];
        for (int i = 0; i < 8; i++) {
            if (crc & 0x0001) {
                crc >>= 1;
                crc ^= 0xA001;
            } else {
                crc >>= 1;
        }
        }
    }
    return crc;
}



void Modbus_Handle(uint8_t *frame, uint16_t size)
{
	// Minimum valid frame: addr + func + 2 data + 2 CRC = 6 bytes
    if (size < 6) return;

    uint16_t crcCalc = Modbus_CRC16(frame, size-2);
    uint16_t crcRecv = frame[size-2] | (frame[size-1] << 8);
    if (crcCalc != crcRecv) return;

    if (frame[0] != MODBUS_SLAVE_ADDR) return;

    uint8_t func = frame[1];
    uint8_t txBuf[32];
    uint16_t txLen = 0;


    // ── FC01: Read Coils ───────────────────────────────────────────────────────
     // Query:    01 01 00 00 00 04 3D C9
     // Response: 01 01 01 <coil_byte> CRC_L CRC_H
     //           coil_byte bit0=relay1 … bit3=relay4


    if (func == 0x01) { // Read Coils
        uint16_t start = (frame[2] << 8) | frame[3];
        uint16_t qty   = (frame[4] << 8) | frame[5];

        if (qty > NUM_COILS) return; // sanity guard

        txBuf[0] = frame[0];
        txBuf[1] = func;
        txBuf[2] = (qty+7)/8;
        memset(&txBuf[3], 0,  txBuf[2]);

        for (int i=0; i< (int)qty; i++) {
            if (Coil_Read(start+i))
                txBuf[3 + (i/8)] |= (1 << (i%8));
        }
        txLen = 3 + txBuf[2];
    }


        // ── FC02: Read Discrete Inputs ─────────────────────────────────────────────
         // Query:    01 02 00 00 00 04 79 C9
         // Response: 01 02 01 <din_byte> CRC_L CRC_H
         //           din_byte bit0=DIN1 … bit3=DIN4
    else if (func == 0x02)
     {
       uint16_t start = (frame[2] << 8) | frame[3];
       uint16_t qty   = (frame[4] << 8) | frame[5];

       if (qty > NUM_DIN) return; // sanity guard

       txBuf[0] = frame[0];
       txBuf[1] = func;
       txBuf[2] = (qty + 7) / 8;   // byte count
       memset(&txBuf[3], 0, txBuf[2]);

       for (int i = 0; i < (int)qty; i++) {
           if (dinLatch[start + i]) {
               txBuf[3 + (i / 8)] |= (1 << (i % 8));
               dinLatch[start + i] = 0; // clear after reading — auto resets
           }

       }
       txLen = 3 + txBuf[2];
     }



    // ── FC04: Read Input Registers (ADC) ───────────────────────────────────────
    // Query:    01 04 00 00 00 04 F1 C9
    // Response: 01 04 08 HH LL HH LL HH LL HH LL CRC_L CRC_H
    //           Register 0=AIN1(PA3) 1=AIN2(PA2) 2=AIN3(PA1) 3=AIN4(PA0)
    else if (func == 0x04)
    {
      uint16_t start = (frame[2] << 8) | frame[3];
      uint16_t qty   = (frame[4] << 8) | frame[5];

      if (qty > 4) return; // sanity guard

      txBuf[0] = frame[0];
      txBuf[1] = func;
      txBuf[2] = qty * 2; // byte count

      for (int i = 0; i < (int)qty; i++) {
        uint16_t val = 0;
        switch (start + i) {
          case 0: val = adcValue[0]; break; // AIN1 PA3
          case 1: val = adcValue[1]; break; // AIN2 PA2
          case 2: val = adcValue[2]; break; // AIN3 PA1
          case 3: val = adcValue[3]; break; // AIN4 PA0
          default: val = 0; break;
        }
        txBuf[3 + i * 2] = (val >> 8) & 0xFF; // high byte first (big-endian)
        txBuf[4 + i * 2] =  val       & 0xFF;
      }
      txLen = 3 + qty * 2;
    }


    // ── FC05: Write Single Coil ────────────────────────────────────────────────
      // Query ON:  01 05 00 00 FF 00 8C 3A   (coil 0 ON)
      // Query OFF: 01 05 00 00 00 00 CD CA   (coil 0 OFF)
      // Response echoes the request unchanged
      else if (func == 0x05)
      {
        uint16_t coil = (frame[2] << 8) | frame[3];
        uint16_t val  = (frame[4] << 8) | frame[5];

        if (coil >= NUM_COILS) return; // sanity guard

        Coil_Write(coil, (val == 0xFF00) ? 1 : 0);
        memcpy(txBuf, frame, 6); // echo first 6 bytes (addr+func+addr+val)
        txLen = 6;
      }

      // Unknown function — nothing to transmit
      else
      {
        return;
      }


    // ── Transmit response

    uint16_t crc = Modbus_CRC16(txBuf, txLen);
    txBuf[txLen++] = crc & 0xFF;
    txBuf[txLen++] = (crc >> 8) & 0xFF;

    txInProgress = 1; // ISR will discard any echo bytes during TX

    HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_SET);
    HAL_Delay(1);                                          // DE settling time (~1 bit period)
    HAL_UART_Transmit(&huart1, txBuf, txLen, HAL_MAX_DELAY);
    HAL_Delay(2);                                          // let last stop bit leave shift register
    HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_RESET);
    HAL_Delay(1);                                          // RE settling before listening again

    txInProgress = 0; // safe to receive again
  }


// ── UART ISR callback ─────────────────────────────────────────────────────────
// Fires when UART goes idle after receiving bytes (ReceiveToIdle mode).
// Keep this SHORT — just copy buffer and set flag, let main loop process it.

void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
  if (huart->Instance == USART1)
  {
    if (txInProgress)
    {
      // Own TX echo received — discard silently, re-arm and return
      HAL_UARTEx_ReceiveToIdle_IT(&huart1, rxBuffer, RX_BUFFER_SIZE);
      return;
    }

    // Minimum Modbus frame = 6 bytes (addr+func+2data+2crc)
    if (!modbusFrameReady && Size >= 6)
    {
      memcpy(rxWorkBuf, rxBuffer, Size);
      rxWorkSize       = Size;
      modbusFrameReady = 1;
    }

    // Always re-arm — must not miss the next frame
    HAL_UARTEx_ReceiveToIdle_IT(&huart1, rxBuffer, RX_BUFFER_SIZE);
  }
}

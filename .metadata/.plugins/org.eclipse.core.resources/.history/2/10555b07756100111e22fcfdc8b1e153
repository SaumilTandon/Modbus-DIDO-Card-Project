/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  My_ADC_Init(); // ADC self-calibration

   // Arm UART receiver — must be called once before the main loop
   HAL_UARTEx_ReceiveToIdle_IT(&huart1, rxBuffer, RX_BUFFER_SIZE);



  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  /* USER CODE BEGIN 3 */

	      // ── 1. Process any received Modbus frame ────────────────────────────────
	      // Modbus_Handle runs here in main context, never inside the ISR.
	      // This avoids blocking the ISR with UART TX and ADC reads.
	      if (modbusFrameReady)
	      {
	        modbusFrameReady = 0;
	        Modbus_Handle(rxWorkBuf, rxWorkSize);
	      }

	      // ── 2. Sample all four ADC channels ─────────────────────────────────────
	      // Correct order matches schematic: AIN1=PA3 … AIN4=PA0
	      adcValue[0] = My_ADC_Read(ADC_CHANNEL_3); // AIN1 → PA3
	      adcValue[1] = My_ADC_Read(ADC_CHANNEL_2); // AIN2 → PA2
	      adcValue[2] = My_ADC_Read(ADC_CHANNEL_1); // AIN3 → PA1
	      adcValue[3] = My_ADC_Read(ADC_CHANNEL_0); // AIN4 → PA0


	      // ── 3. Update digital input latch (for Modbus FC02) ─────────────────────────
	      for (int i = 0; i < NUM_DIN; i++) {
	          if (DIn_Read(i)) dinLatch[i] = 1;   // set on HIGH; FC02 clears it
	      }

	      // ── 4. Refresh relay shadow ──────────────────────────────────────────────────
	      for (int i = 0; i < NUM_COILS; i++)
	          coilStatus[i] = Coil_Read(i);

	      // ── 5. Print combined status every 500 ms ────────────────────────────────────
	      static uint32_t lastPrint = 0;
	      if (HAL_GetTick() - lastPrint >= 500)
	      {
	          lastPrint = HAL_GetTick();
	          Status_SendDebug();
	      }

	      // No HAL_Delay here — ADC reads already take ~1ms total,
	      // keeping the loop fast so Modbus frames are processed promptly.


  }
  /* USER CODE END 3 */
}


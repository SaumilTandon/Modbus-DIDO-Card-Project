uint16_t My_ADC_Read(uint32_t channel)
{
	 HAL_ADC_Stop(&hadc);          // ensure clean state before reconfiguring
	    ADC1->CHSELR = 0;             // clear all channels - THE critical fix
	    ADC_ChannelConfTypeDef sConfig = {0};
	    sConfig.Channel      = channel;
	    sConfig.Rank         = ADC_RANK_CHANNEL_NUMBER;
	    sConfig.SamplingTime = ADC_SAMPLETIME_55CYCLES_5;
	    if (HAL_ADC_ConfigChannel(&hadc, &sConfig) != HAL_OK)
	        return 0xFFFF;            // distinct error sentinel
	    if (HAL_ADC_Start(&hadc) != HAL_OK)
	        return 0xFFFF;
	    if (HAL_ADC_PollForConversion(&hadc, 10) != HAL_OK)
	        return 0xFFFF;
	    uint16_t value = HAL_ADC_GetValue(&hadc);
	    HAL_ADC_Stop(&hadc);
	    return value;
}

void Coil_Write(uint8_t coilIndex, uint8_t value)
{
    if (coilIndex < NUM_COILS) {
        coilStatus[coilIndex] = value ? 1 : 0;
        HAL_GPIO_WritePin(coilPortMap[coilIndex], coilPinMap[coilIndex],
                          value ? GPIO_PIN_SET : GPIO_PIN_RESET);
    }
}

uint8_t Coil_Read(uint8_t coilIndex)
{
    if (coilIndex < NUM_COILS) {
        return coilStatus[coilIndex];  // Read shadow, not GPIO IDR
    }
    return 0;
}

uint16_t Modbus_CRC16(uint8_t *buf, uint16_t len)
{
    uint16_t crc = 0xFFFF;
    for (uint16_t pos = 0; pos < len; pos++) {
        crc ^= buf[pos];
        for (int i = 0; i < 8; i++) {
            if (crc & 0x0001) {
                crc >>= 1;
                crc ^= 0xA001;
            } else {
                crc >>= 1;
            }
        }
    }
    return crc;
}

#define MODBUS_SLAVE_ADDR 0x01

void Modbus_Handle(uint8_t *frame, uint16_t size)
{
    if (size < 4) return;

    uint16_t crcCalc = Modbus_CRC16(frame, size-2);
    uint16_t crcRecv = frame[size-2] | (frame[size-1] << 8);
    if (crcCalc != crcRecv) return;

    if (frame[0] != MODBUS_SLAVE_ADDR) return;

    uint8_t func = frame[1];
    uint8_t txBuf[32];
    uint16_t txLen = 0;

    if (func == 0x01) { // Read Coils
        uint16_t start = (frame[2] << 8) | frame[3];
        uint16_t qty   = (frame[4] << 8) | frame[5];
        txBuf[0] = frame[0];
        txBuf[1] = func;
        txBuf[2] = (qty+7)/8;
        memset(&txBuf[3], 0, (qty+7)/8);

        for (int i=0; i<qty; i++) {
            if (Coil_Read(start+i))
                txBuf[3 + (i/8)] |= (1 << (i%8));
        }
        txLen = 3 + txBuf[2];
    }
    else if (func == 0x05) { // Write Single Coil
        uint16_t coil = (frame[2] << 8) | frame[3];
        uint16_t val  = (frame[4] << 8) | frame[5];
        Coil_Write(coil, (val == 0xFF00) ? 1 : 0);
        memcpy(txBuf, frame, 6);
        txLen = 6;
    }
    else if (func == 0x04) { // Read Input Registers
        uint16_t start = (frame[2] << 8) | frame[3];
        uint16_t qty   = (frame[4] << 8) | frame[5];

        txBuf[0] = frame[0];
        txBuf[1] = func;
        txBuf[2] = qty * 2; // byte count

        for (int i=0; i<qty; i++) {
            uint16_t val = 0;
            switch (start+i) {
            case 0: val = adcValue[0]; break;  // AIN1 (PA3) — already sampled in main
            case 1: val = adcValue[1]; break;  // AIN2 (PA2)
            case 2: val = adcValue[2]; break;  // AIN3 (PA1)
            case 3: val = adcValue[3]; break;  // AIN4 (PA0)

            }
            txBuf[3 + i*2] = (val >> 8) & 0xFF;
            txBuf[4 + i*2] = val & 0xFF;
        }
        txLen = 3 + qty*2;
    }

    uint16_t crc = Modbus_CRC16(txBuf, txLen);
        txBuf[txLen++] = crc & 0xFF;
        txBuf[txLen++] = (crc >> 8) & 0xFF;

        txInProgress = 1;  // tell ISR to ignore echo

        HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_SET);
        HAL_Delay(1);  // DE settling time

        HAL_UART_Transmit(&huart1, txBuf, txLen, HAL_MAX_DELAY);

        // Wait for last bit to physically leave the shift register
        // 9600 baud = ~1.04ms/byte. txLen max ~12 bytes but guard generously
        HAL_Delay(2);

        HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_RESET);
        HAL_Delay(1);  // RE settling before we start listening again

        txInProgress = 0;  // now safe to receive again
}

void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
    if (huart->Instance == USART1)
    {
        // TEMP TEST: respond immediately to anything received, no processing
        uint8_t testResp[] = {0xDE, 0xAD, 0xBE, 0xEF};
        HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_SET);
        HAL_Delay(1);
        HAL_UART_Transmit(&huart1, testResp, sizeof(testResp), 100);
        HAL_Delay(2);
        HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_RESET);

        HAL_UARTEx_ReceiveToIdle_IT(&huart1, rxBuffer, RX_BUFFER_SIZE);
        return;
    }
}


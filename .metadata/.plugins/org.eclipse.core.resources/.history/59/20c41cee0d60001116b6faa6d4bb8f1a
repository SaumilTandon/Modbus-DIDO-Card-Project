/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  My_ADC_Init();   // run calibration


   HAL_UARTEx_ReceiveToIdle_IT(&huart1, rxBuffer, RX_BUFFER_SIZE);

   uint8_t beacon[] = {0xAA, 0x55, 0xAA, 0x55};
   HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_SET);
   HAL_Delay(1);
   HAL_UART_Transmit(&huart1, beacon, sizeof(beacon), 100);
   HAL_Delay(2);
   HAL_GPIO_WritePin(RS485_DE_RE_GPIO_Port, RS485_DE_RE_Pin, GPIO_PIN_RESET);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  if (modbusFrameReady)
	      {
	          modbusFrameReady = 0;
	          Modbus_Handle(rxWorkBuf, rxWorkSize);
	      }

	      // ADC sampling (correct channel order matching schematic)
	      adcValue[0] = My_ADC_Read(ADC_CHANNEL_3); // AIN1 → PA3
	      adcValue[1] = My_ADC_Read(ADC_CHANNEL_2); // AIN2 → PA2
	      adcValue[2] = My_ADC_Read(ADC_CHANNEL_1); // AIN3 → PA1
	      adcValue[3] = My_ADC_Read(ADC_CHANNEL_0); // AIN4 → PA0

	      // Relay status (shadow array read - from previous fix)
	      for (int i = 0; i < NUM_COILS; i++) {
	          coilStatus[i] = Coil_Read(i);
	      }

	      HAL_Delay(100);




	  GPIO_PinState state = HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_3);

	      if (state == GPIO_PIN_RESET) {
	          // Button pressed
	          printf("1\r\n");
	      } else {
	          // Button not pressed
	          printf("0\r\n");
	      }

	      HAL_Delay(200);



  }
  /* USER CODE END 3 */
}

